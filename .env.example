# Notion (persistence for Users API)
# If unset, the storage adapter falls back to in-memory (data resets on restart).
NOTION_TOKEN=
NOTION_SIGNUPS_DB_ID=f39288dd-c29a-461e-91f6-f89910326a7e

# PostHog (analytics + feature flags)
# If unset, the track() wrapper logs to console instead.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public site URL — used by sitemap.ts, robots.ts, and layout.tsx's metadataBase.
# If unset, falls back to a Vercel-shaped placeholder. Set to the actual prod
# URL after first deploy (e.g. https://fx-replay-growth-challenge.vercel.app).
NEXT_PUBLIC_SITE_URL=
